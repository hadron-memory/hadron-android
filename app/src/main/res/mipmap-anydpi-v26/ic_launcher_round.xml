<?xml version="1.0" encoding="utf-8"?>
<!--
    No <monochrome>: the Hadron mark is a two-tone opaque disc, so its alpha
    silhouette is a featureless circle. A themed icon of a plain blob reads
    worse than the system falling back to the full-colour icon.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MonochromeLauncherIcon">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
