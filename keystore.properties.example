# Template for keystore.properties — copy to `keystore.properties` (gitignored)
# and fill in. Never commit the real file or the keystore itself.
#
# Create the upload key first (once, and keep the .jks and its passwords in
# your password manager — losing them means you can no longer update the app
# unless you are enrolled in Play App Signing and request a key reset):
#
#   keytool -genkeypair -v \
#     -keystore hadron-upload.jks \
#     -alias hadron-upload \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# storeFile is resolved relative to the repo root.

storeFile=hadron-upload.jks
storePassword=
keyAlias=hadron-upload
keyPassword=

# CI alternative: leave keystore.properties absent and set these instead —
#   HADRON_KEYSTORE_FILE, HADRON_KEYSTORE_PASSWORD,
#   HADRON_KEY_ALIAS, HADRON_KEY_PASSWORD
